# Browser-safe Supabase configuration only. Never put a service-role or
# sb_secret_ key in any VITE_* variable.
VITE_SUPABASE_PROJECT_ID="your-staging-project-id"
VITE_SUPABASE_URL="https://your-staging-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_staging_key"

# Keep false for local-only/production-stable builds until the reviewed staging gate.
VITE_SECURE_SYNC_PHASE1="false"
# Keep false until Test-profile staging verification and a separate rollout approval.
VITE_SECURE_SYNC_REAL_PROFILE_MIGRATION="false"

# Server runtime equivalents. Privileged keys belong only in the hosting or
# Supabase secret manager and must never be committed.
SUPABASE_PROJECT_ID="your-staging-project-id"
SUPABASE_URL="https://your-staging-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_staging_key"
